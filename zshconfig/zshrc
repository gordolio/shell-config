# =============================================================================
# Startup layers
# =============================================================================
#
# env.zsh + env.d/   every shell, humans and agents: PATH, exports, and wrappers
#                    that decide whether a command works or is safe. zprofile
#                    loads it too, for login shells that never read this file.
# below this check   interactive shells only: plugins, prompt, completions, key
#                    bindings, and wrappers that only change output or swap the
#                    tool (grep -> rg, ls -> eza, vim -> neovide, ...).
#
# Agents run non-interactive shells. Claude Code sources this file from a
# non-interactive login shell and snapshots whatever it defines, so nothing past
# the interactive check reaches agent commands.
#
# Profile startup: ZSH_PROFILE_STARTUP=1 zsh -i -c exit

[[ -n $ZSH_PROFILE_STARTUP ]] && zmodload zsh/zprof

__zshconfig="${${:-$HOME/.zshrc}:A:h}"

source "$__zshconfig/env.zsh"

if [[ ! -o interactive ]]; then
  unset __zshconfig
  return 0
fi

# =============================================================================
# Cached init scripts
# =============================================================================

# Source a tool's generated init script from a cache instead of running the tool
# on every start. Rebuilt when the command changes, when the stamp binary resolves
# to a new path (Homebrew upgrades move it to a new Cellar directory), or when it
# is newer than the cache. Pass the shell explicitly: tools that guess it from
# $SHELL can emit another shell's syntax.
#   __cached_eval <cache-name> <stamp-binary> <command> [args...]
function __cached_eval {
  local name=$1 bin=${commands[$2]:A}
  shift 2
  [[ -n $bin ]] || return 1

  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-$name.zsh"
  local stamp="# generated from $bin by: $*" first=""
  [[ -r $cache ]] && read -r first < "$cache"

  if [[ "$first" != "$stamp" || "$bin" -nt "$cache" ]]; then
    mkdir -p "${cache:h}"
    if ! { print -r -- "$stamp"; command "$@"; } >| "$cache.tmp" 2>/dev/null; then
      rm -f "$cache.tmp"
      return 1
    fi
    mv -f "$cache.tmp" "$cache"
  fi

  source "$cache"
}

# =============================================================================
# Zinit plugin manager
# =============================================================================

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Auto-install zinit if missing
if [[ ! -d "$ZINIT_HOME" ]]; then
  print -P "%F{33}Installing zinit...%f"
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" && \
    print -P "%F{green}Done.%f" || \
    print -P "%F{red}Failed.%f"
fi

source "${ZINIT_HOME}/zinit.zsh"

# =============================================================================
# Zinit plugins (turbo mode for fast startup)
# =============================================================================

zinit wait lucid for \
  zsh-users/zsh-completions \
  zsh-users/zsh-autosuggestions \
  atload"!_zsh_autosuggest_start" \
    zsh-users/zsh-syntax-highlighting

# =============================================================================
# Completions
# =============================================================================

# Full compinit (with its security audit) at most once a day; otherwise trust the
# existing dump. Delete ~/.zcompdump to force a rebuild after installing tools.
autoload -Uz compinit
() {
  setopt local_options extended_glob
  local dump="${ZDOTDIR:-$HOME}/.zcompdump"
  if [[ -n $dump(#qN.mh+24) || ! -s $dump ]]; then
    compinit
  else
    compinit -C
  fi
}
zinit cdreplay -q

# =============================================================================
# Shell options (replaces what Oh My Zsh set)
# =============================================================================

setopt auto_cd
setopt interactive_comments
setopt prompt_subst
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_silent

# =============================================================================
# Source personal.d/ configs (sorted: 00- first, zz- last)
# =============================================================================

__personal_d="$__zshconfig/personal.d"

# Source all *.zsh files from personal.d/ (sorted order)
if [[ -d "$__personal_d" ]]; then
  for __f in "$__personal_d"/*.zsh(N); do
    source "$__f"
  done
fi

# Source all *.zsh files from personal.d/functions/
if [[ -d "$__personal_d/functions" ]]; then
  for __f in "$__personal_d/functions"/*.zsh(N); do
    source "$__f"
  done
fi

unset __personal_d __f

# =============================================================================
# Oh My Posh prompt
# =============================================================================

# Not cached: its init output carries a per-session id.
if (( $+commands[oh-my-posh] )); then
  eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/jandedobbeleer.omp.yaml)"
fi

# =============================================================================
# End-of-file integrations
# =============================================================================

# GD keys (legacy)
if [[ -f "$HOME/.zsh/gd_key.txt" ]]; then
  export GD_KEY=$(<"$HOME/.zsh/gd_key.txt")
  export GD_SECRET=$(<"$HOME/.zsh/gd_secret.txt")
fi

# fzf
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# SDKMAN: candidates are already on PATH (env.d/zz-path-priority.zsh); the `sdk`
# command loads sdkman-init.sh on first use.
if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
  function sdk {
    unfunction sdk
    source "$SDKMAN_DIR/bin/sdkman-init.sh"
    sdk "$@"
  }
fi

# NVM: node comes from asdf, and nvm's default node is already on PATH
# (env.d/zz-path-priority.zsh); `nvm` loads nvm.sh on first use.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  function nvm {
    unfunction nvm
    source "$NVM_DIR/nvm.sh"
    nvm "$@"
  }
fi

# Heroku autocomplete
HEROKU_AC_ZSH_SETUP_PATH="$HOME/Library/Caches/heroku/autocomplete/zsh_setup"
[[ -f "$HEROKU_AC_ZSH_SETUP_PATH" ]] && source "$HEROKU_AC_ZSH_SETUP_PATH"

unset __zshconfig

[[ -n $ZSH_PROFILE_STARTUP ]] && zprof
