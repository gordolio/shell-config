# Copy to ~/.config/op/opencode.env or to ignored op/opencode.env.
# References are op://VAULT/ITEM/FIELD. Select the account with OP_ACCOUNT.

ANTHROPIC_API_KEY=op://VAULT/Anthropic API Key/credential
OPENAI_API_KEY=op://VAULT/OpenAI API Key/credential
GOOGLE_GENERATIVE_AI_API_KEY=op://VAULT/Gemini API Key/credential
LINEAR_API_KEY=op://VAULT/Linear API Key/credential
FIGMA_API_KEY=op://VAULT/Figma API Key/credential
MAVELY_E2E_EMAIL=op://VAULT/E2E Test Account/username
MAVELY_E2E_PASSWORD=op://VAULT/E2E Test Account/password
